# URL del backend (sin trailing slash en /api)
VITE_API_URL=https://delasoft-back.onrender.com/api

# Solo para `npm run dev`: destino del proxy local de Vite.
# En producción Vercel continúa usando VITE_API_URL.
VITE_DEV_PROXY_TARGET=http://localhost:4000

# Clave pública VAPID para push notifications
# Genera con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
